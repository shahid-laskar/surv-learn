# Edge NVR site identity (from hub NVR Fleet provision screen)
SITE_CODE=SITE01
SITE_TOKEN=replace-with-token-from-hub-provision

# Hub API — use LAN IP when testing on same network; overlay IP when on VPN
HUB_API_URL=http://10.44.0.209:8000/api/v1

# Published ports on this edge box (change if multiple sites on one test VM)
HLS_PORT=8888
RTSP_PORT=8554
MGMT_PORT=9997

# Critical-clip backup to hub MinIO (optional; leave MINIO_ENDPOINT empty to disable upload)
MINIO_ENDPOINT=10.44.0.209:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme123
MINIO_BUCKET_BACKUP=backup_clips
MINIO_USE_SSL=false
BACKUP_ENABLED=true
BACKUP_TRIGGER=motion
BACKUP_CLIP_SECONDS=15

# VPN profile (docker compose --profile vpn)
HEADSCALE_DOMAIN=vpn.sarvanetra.bsnl.co.in
ENROLLMENT_PREAUTH_KEY=
