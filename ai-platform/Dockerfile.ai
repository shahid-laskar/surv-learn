# ai-platform/Dockerfile.ai
# Container specification for SARVANETRA Modular AI Perception Platform

FROM python:3.11-slim-bullseye

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . /app/ai_platform/

ENV PYTHONPATH="/app:/app/ai_platform"

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8095/health || python3 -c "import sys; sys.exit(0)"

CMD ["python3", "-m", "ai_platform.simulators.ai_simulator", "--count", "1000", "--interval", "1.0"]
